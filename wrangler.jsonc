{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "code-sortings",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-07-24",
  "cache": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "sort.yusuke-hayashi.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "preview_urls": true
}
